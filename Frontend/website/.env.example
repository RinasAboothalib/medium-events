# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Public address of the live site (no trailing slash). Used for canonical
# links, social share previews and the sitemap. Defaults to https://medium.mv.
VITE_SITE_URL="https://medium.mv"

# VITE_WEB3FORMS_KEY: Access key from web3forms.com (sign up with info@medium.mv).
# When empty, the enquiry form sends via WhatsApp / email instead.
VITE_WEB3FORMS_KEY=""

# VITE_GA_ID: Google Analytics 4 measurement ID (G-XXXXXXX). When empty, no analytics load.
VITE_GA_ID=""

# VITE_ADMIN_URL: Address of the staff admin app (no trailing slash). The footer "Staff login" link
# goes to <VITE_ADMIN_URL>/login. Defaults to http://localhost:3010 for development.
VITE_ADMIN_URL=""

# VITE_ADMIN_API_URL: Address of the MEDIUM admin server (no trailing slash), e.g. https://admin.medium.mv.
# When set, the build uses the events published from the admin (Publish page) and the enquiry form
# also records enquiries there. When empty, the site uses its built-in event list.
VITE_ADMIN_API_URL=""
