# Port the API listens on
PORT=3020
# Leave empty to use the local database in server/.data (no setup needed).
# For Supabase: Project Settings > Database > Connection string > Session pooler (URI), with your database password.
DATABASE_URL=""
# First password for the default admin (admin@medium.mv). Empty = Medium@2026! . Must be changed at first sign-in.
DEFAULT_ADMIN_PASSWORD=""
# Public website address allowed to send enquiries to the API, e.g. https://medium.mv
PUBLIC_SITE_ORIGIN="http://localhost:3005"
# Optional: URL the server POSTs to after "Publish to website" to trigger a site rebuild
SITE_DEPLOY_HOOK_URL=""
NODE_ENV="development"
