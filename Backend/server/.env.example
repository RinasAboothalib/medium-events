# Port the API listens on
PORT=3020
# Leave empty to use the local database in Backend/server/.data (no setup needed).
# For Supabase: Project Settings > Database > Connection string > Session pooler (URI), with your database password.
# SSL is used automatically, except for this machine or the host's private network (e.g. Railway's *.railway.internal).
# Add ?sslmode=disable or ?sslmode=require to the URL to override.
DATABASE_URL=""
# First password for the default admin (admin@medium.mv). Empty = Medium@2026! . Must be changed at first sign-in.
DEFAULT_ADMIN_PASSWORD=""
# Website address(es) allowed to send enquiries to the API from the browser, comma-separated,
# e.g. "https://medium.mv, https://www.medium.mv". Empty in development = the website's dev server (localhost:3000) and preview (localhost:4173).
PUBLIC_SITE_ORIGIN=""
# Optional: URL the server POSTs to after "Publish to website" to trigger a site rebuild
SITE_DEPLOY_HOOK_URL=""
NODE_ENV="development"
